# Use SQLite for a zero-setup local demo.  Replace with your PostgreSQL URL when ready.
DATABASE_URL=sqlite:///./cti_hub.db

# Redis or Memurai is required only for background AI analysis.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Required for Gemini summaries.  Leave blank to run the API and dashboard without AI enrichment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Replace before deploying anywhere other than your own computer.
JWT_SECRET=replace-with-a-long-random-local-secret
